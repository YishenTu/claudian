{
  "name": "claudian",
  "version": "2.1.4",
  "description": "Claudian - Claude Code embedded in Obsidian sidebar",
  "main": "main.js",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "build:css": "node scripts/build-css.mjs",
    "build:protocol": "npm --prefix packages/collab-protocol run build",
    "predev": "npm run build:protocol",
    "dev": "npm run build:css && node esbuild.config.mjs",
    "prebuild": "npm run build:protocol",
    "build": "node scripts/build.mjs production",
    "check:lockfile": "bun install --frozen-lockfile --ignore-scripts",
    "precheck:open-handles": "npm run build:protocol",
    "check:open-handles": "node scripts/check-open-handles.mjs",
    "check:performance": "node scripts/check-startup-performance.mjs",
    "precheck:protocol-compatibility": "npm run build:protocol",
    "check:protocol-compatibility": "node scripts/check-collab-protocol-compatibility.mjs",
    "pretypecheck": "npm run build:protocol",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.source.json",
    "prelint": "npm run build:protocol",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:ts": "eslint \"{src,tests,packages/collab-protocol/src,packages/collab-protocol/tests}/**/*.ts\" --max-warnings=0",
    "lint:css": "stylelint \"src/style/**/*.css\"",
    "prelint:fix": "npm run build:protocol",
    "lint:fix": "npm run lint:ts -- --fix && npm run lint:css -- --fix",
    "pretest": "npm run build:protocol",
    "test": "npm run test:protocol -- --runInBand && node scripts/run-tests.js",
    "pretest:unit": "npm run build:protocol",
    "test:unit": "node scripts/run-jest.js",
    "test:protocol": "npm --prefix packages/collab-protocol test",
    "pretest:cross-platform-collab": "npm run build:protocol",
    "test:cross-platform-collab": "node scripts/run-cross-platform-collab-tests.js",
    "verify:protocol": "node packages/collab-protocol/scripts/verify-pack.mjs",
    "test:architecture": "node --test scripts/check-architecture-boundaries.test.mjs",
    "pretest:watch": "npm run build:protocol",
    "test:watch": "node scripts/run-jest.js --watch",
    "pretest:coverage": "npm run build:protocol",
    "test:coverage": "node scripts/run-jest.js --coverage",
    "preversion": "bun install --frozen-lockfile",
    "version": "node scripts/sync-version.js && git add manifest.json"
  },
  "keywords": [
    "claude-code",
    "obsidian",
    "obsidian-plugin",
    "productivity",
    "ide"
  ],
  "author": "Yishen Tu",
  "license": "MIT",
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.2",
    "@types/node-forge": "1.3.14",
    "@types/sql.js": "1.4.11",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.2.0",
    "eslint-plugin-jest": "^29.15.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jsdom": "^26.1.0",
    "obsidian": "1.13.0",
    "stylelint": "^17.14.1",
    "ts-jest": "^29.4.9",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@claudian/collab-protocol": "0.3.0",
    "@codemirror/commands": "6.10.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@lezer/markdown": "^1.7.2",
    "@modelcontextprotocol/sdk": "~1.30.0",
    "@pierre/diffs": "1.3.5",
    "@pierre/theming": "1.0.1",
    "@shikijs/core": "4.4.3",
    "@shikijs/engine-javascript": "4.4.3",
    "@shikijs/engine-oniguruma": "4.4.3",
    "bonjour-service": "1.4.4",
    "node-forge": "1.4.0",
    "smol-toml": "^1.6.1",
    "sql.js": "1.14.1",
    "tslib": "^2.8.1",
    "ws": "8.21.2"
  },
  "overrides": {
    "@codemirror/state": "$@codemirror/state",
    "@codemirror/view": "$@codemirror/view",
    "@babel/core": "7.29.7",
    "@hono/node-server": "2.0.11",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.3.1",
    "js-yaml": "4.3.1"
  }
}
