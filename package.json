{
  "name": "claudian",
  "version": "2.3.36",
  "description": "Claudian - Claude Code embedded in Obsidian sidebar",
  "main": "main.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "build:css": "node scripts/build-css.mjs",
    "dev": "npm run build:css && node esbuild.config.mjs",
    "build": "node scripts/build.mjs production",
    "check:lockfile": "bun install --frozen-lockfile --ignore-scripts",
    "check:open-handles": "node scripts/check-open-handles.mjs",
    "check:performance": "node scripts/check-startup-performance.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "lint": "eslint \"{src,tests}/**/*.ts\" manifest.json package.json --max-warnings=0 --concurrency=4",
    "lint:fix": "npm run lint -- --fix",
    "test": "node scripts/run-tests.js",
    "test:affected": "node scripts/run-affected-tests.mjs",
    "test:unit": "node scripts/run-vitest.js",
    "test:architecture": "node --test scripts/check-architecture-boundaries.test.mjs",
    "test:watch": "node scripts/run-vitest.js watch",
    "test:coverage": "node scripts/run-vitest.js --coverage",
    "preversion": "bun install --frozen-lockfile",
    "version": "node scripts/sync-version.js && git add manifest.json",
    "test:cross-platform": "node scripts/run-cross-platform-tests.js",
    "mutation": "node scripts/run-mutation.mjs",
    "smoke:obsidian": "node scripts/run-obsidian-smoke.mjs"
  },
  "keywords": [
    "claude-code",
    "obsidian",
    "obsidian-plugin",
    "productivity",
    "ide"
  ],
  "author": "Yishen Tu",
  "license": "MIT",
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@types/cross-spawn": "6.0.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^25.5.2",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "axe-core": "4.12.1",
    "es-toolkit": "1.53.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.2.0",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jsdom": "^26.1.0",
    "obsidian": "1.13.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.293",
    "@codemirror/commands": "6.10.0",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@lezer/markdown": "1.7.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cross-spawn": "7.0.6",
    "jsonc-parser": "3.3.1",
    "tslib": "^2.8.1",
    "ws": "8.21.2",
    "yaml": "2.9.0"
  },
  "overrides": {
    "@codemirror/state": "$@codemirror/state",
    "@codemirror/view": "$@codemirror/view",
    "@hono/node-server": "2.1.5",
    "@humanfs/node": "0.16.8",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "hono": "4.13.13",
    "ip-address": "10.7.4",
    "js-yaml": "4.3.2",
    "moment": "2.31.0",
    "qs": "6.17.1"
  }
}
