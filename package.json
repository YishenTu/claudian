{
  "name": "claudian",
  "version": "2.2.5",
  "description": "Claudian - Claude Code embedded in Obsidian sidebar",
  "main": "main.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "build:css": "node scripts/build-css.mjs",
    "dev": "npm run build:css && node esbuild.config.mjs",
    "build": "node scripts/build.mjs production",
    "check:lockfile": "bun install --frozen-lockfile --ignore-scripts",
    "check:open-handles": "node scripts/check-open-handles.mjs",
    "check:performance": "node scripts/check-startup-performance.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:ts": "eslint \"{src,tests}/**/*.ts\" --max-warnings=0",
    "lint:css": "stylelint \"src/style/**/*.css\"",
    "lint:fix": "npm run lint:ts -- --fix && npm run lint:css -- --fix",
    "test": "node scripts/run-tests.js",
    "test:unit": "node scripts/run-jest.js",
    "test:cross-platform-collab": "node scripts/run-cross-platform-collab-tests.js",
    "test:architecture": "node --test scripts/check-architecture-boundaries.test.mjs",
    "test:watch": "node scripts/run-jest.js --watch",
    "test:coverage": "node scripts/run-jest.js --coverage",
    "preversion": "bun install --frozen-lockfile",
    "version": "node scripts/sync-version.js && git add manifest.json"
  },
  "keywords": [
    "claude-code",
    "obsidian",
    "obsidian-plugin",
    "productivity",
    "ide"
  ],
  "author": "Yishen Tu",
  "license": "MIT",
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@types/cross-spawn": "6.0.6",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.5.2",
    "@types/node-forge": "1.3.14",
    "@types/sql.js": "1.4.11",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.2.0",
    "eslint-plugin-jest": "^29.15.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jest": "^30.3.0",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.3.0",
    "jsdom": "^26.1.0",
    "obsidian": "1.13.0",
    "stylelint": "^17.14.1",
    "terser": "^5.50.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.226",
    "@claudian-collab/protocol": "3.3.2",
    "@codemirror/commands": "6.10.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@lezer/markdown": "1.7.2",
    "@modelcontextprotocol/sdk": "~1.30.0",
    "@pierre/diffs": "1.3.5",
    "@pierre/theming": "1.0.1",
    "bonjour-service": "1.4.4",
    "cross-spawn": "7.0.6",
    "node-forge": "1.4.0",
    "smol-toml": "1.7.1",
    "sql.js": "1.14.1",
    "tslib": "^2.8.1",
    "ws": "8.21.2"
  },
  "overrides": {
    "@codemirror/state": "$@codemirror/state",
    "@codemirror/view": "$@codemirror/view",
    "@babel/core": "7.29.7",
    "@hono/node-server": "2.0.11",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.3.1",
    "js-yaml": "4.3.1"
  }
}
